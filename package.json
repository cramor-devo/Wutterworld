{
  "name": "wutterworld",
  "private": true,
  "version": "0.3.0",
  "description": "Wutterworld – a SNES-style pixel-art side-scroller about a curious sea cucumber.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "start": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
